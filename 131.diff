+
+class TestLargeBatchStandardQuants:
+    """Test large-batch K-quants and standard quants dispatch to ggml_mul_mat_a8 (MMQ)."""
+
+    @pytest.mark.parametrize("qweight_type", [
+        GGML_Q2_K,
+        GGML_Q4_K,
+        GGML_Q6_K,
