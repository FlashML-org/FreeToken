FROM rocm/dev-ubuntu-24.04:10.1.0-full@sha256:5ed1362ea542a928651e4c710b44024ebe98870f74159cb70f0265aec8ef0abe

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      cmake git pkg-config python3-venv xxd \
    && rm -rf /var/lib/apt/lists/*

ENV UV_PYTHON_INSTALL_DIR=/opt/python

RUN python3 -m venv /opt/uv \
    && /opt/uv/bin/python -m pip install --no-cache-dir "uv==0.13.0" \
    && /opt/uv/bin/uv python install 3.13.13 \
    && /opt/uv/bin/uv venv --python 3.13.13 --seed /opt/venv \
    && ln -s /opt/uv/bin/uv /usr/local/bin/uv

ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:/opt/rocm/bin:${PATH} \
    LD_LIBRARY_PATH=/opt/rocm/lib

RUN python -m pip install --no-cache-dir --upgrade \
      pip "setuptools>=77,<82" wheel ninja "numpy>=2.0,<3" \
    && python -m pip install --no-cache-dir \
      --index-url https://stable.repo.amd.com/rocm/whl-next \
      "torch[device-all]==2.14.0+rocm10.1.0" \
      "torchvision[device-all]==0.29.0a0+rocm10.1.0" \
      "triton==3.8.0+git669b31ac.rocm10.1.0"

RUN python -m pip install --no-cache-dir \
      "apache-tvm-ffi==0.1.13.post3" \
      "einops>=0.8,<1" \
      "fastapi>=0.115,<1" \
      "flashlib==0.4.0" \
      "gguf>=0.19,<1" \
      "huggingface_hub>=1.5,<2" \
      "msgpack>=1.1,<2" \
      "modelscope>=1.37,<2" \
      "numpy>=2.0,<3" \
      "openai>=2.0,<3" \
      "partial-json-parser>=0.2,<1" \
      "pillow>=10,<13" \
      "prompt_toolkit>=3.0,<4" \
      "pydantic>=2.9,<3" \
      "pytest>=6.0" \
      "pyzmq>=27,<28" \
      "safetensors>=0.6,<1" \
      "tqdm>=4.66,<5" \
      "transformers==5.18.0" \
      "uvicorn>=0.30,<1" \
    && python -m pip check \
    && python -c "import sys, importlib.metadata as m, torch, triton, torchvision; assert sys.version_info[:2] == (3, 13); assert torch.__version__ == '2.14.0+rocm10.1.0'; assert torch.version.hip and torch.version.cuda is None; assert m.version('torchvision') == '0.29.0a0+rocm10.1.0'; assert m.version('triton') == '3.8.0+git669b31ac.rocm10.1.0'"
